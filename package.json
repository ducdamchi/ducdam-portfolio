{
  "name": "ducdam-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "tabWidth": 2,
    "plugins": [
      "prettier-plugin-tailwindcss",
      "prettier-plugin-css-order"
    ]
  },
  "type": "module",
  "scripts": {
    "dev:film-photo": "pnpm --filter @ducdam/film-photo dev",
    "dev:celebrations": "pnpm --filter @ducdam/celebrations dev",
    "dev:software": "pnpm --filter @ducdam/software dev",
    "dev:woodworking": "pnpm --filter @ducdam/woodworking dev",
    "dev:all": "pnpm --filter @ducdam/film-photo dev & pnpm --filter @ducdam/celebrations dev & pnpm --filter @ducdam/software dev & pnpm --filter @ducdam/woodworking dev",
    "build:film-photo": "pnpm --filter @ducdam/film-photo build",
    "build:celebrations": "pnpm --filter @ducdam/celebrations build",
    "build:software": "pnpm --filter @ducdam/software build",
    "build:woodworking": "pnpm --filter @ducdam/woodworking build",
    "lint": "pnpm -r lint",
    "deploy:film-photo": "pnpm build:film-photo && gh-pages -d 'sites/film & photo/dist' -r git@github.com:ducdamchi/art-portfolio-react.git -b gh-pages",
    "deploy:celebrations": "pnpm build:celebrations && gh-pages -d sites/celebrations/dist -r git@github.com:ducdamchi/celebrations-site.git -b gh-pages",
    "deploy:woodworking": "pnpm build:woodworking && gh-pages -d sites/woodworking/dist -r git@github.com:ducdamchi/woodworking-site.git -b gh-pages",
    "deploy:software": "pnpm build:software && gh-pages -d sites/software/dist -r git@github.com:ducdamchi/software-site.git -b gh-pages"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "gh-pages": "^6.3.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
